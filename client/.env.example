# Public API origin (no trailing slash). Required on Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Socket.IO host — usually same as API. Optional; falls back to NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Optional — Paystack public key for Inline JS checkout later
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_…
